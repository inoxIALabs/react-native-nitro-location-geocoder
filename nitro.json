{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "locationgeocoder"
  ],
  "ios": {
    "iosModuleName": "NitroLocationGeocoder"
  },
  "android": {
    "androidNamespace": [
      "locationgeocoder"
    ],
    "androidCxxLibName": "NitroLocationGeocoder"
  },
  "autolinking": {
    "LocationGeocoder": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridLocationGeocoder"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridLocationGeocoder"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
